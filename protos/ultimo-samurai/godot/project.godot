; Engine configuration file.
; Godot 4.7, renderer Compatibility (WebGL 2).

config_version=5

[application]

config/name="El último samurai"
config/description="Metroidvania 3D de un samurai, katas y un jefe."
run/main_scene="res://escenas/principal.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.09, 0.05, 0.14, 1)
boot_splash/show_image=false

[autoload]

Taller="*res://scripts/taller.gd"
Sonido="*res://scripts/sonido.gd"
Efectos="*res://scripts/efectos.gd"
Partida="*res://scripts/partida.gd"

[display]

window/size/viewport_width=390
window/size/viewport_height=844
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/size/window_width_override=390
window/size/window_height_override=844

[gui]

theme/custom="res://tema/juego.tres"
theme/default_font_multichannel_signed_distance_field=true

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
environment/defaults/default_clear_color=Color(0.09, 0.05, 0.14, 1)
