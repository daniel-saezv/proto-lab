; Muestra mínima para medir el export web. No es una aplicación del laboratorio.
; Viewport de teléfono, renderer compatible con la web, sin hilos.

config_version=5

[application]

config/name="Medida minima"
config/description="Muestra minima para medir el export web de un solo hilo."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=390
window/size/viewport_height=844
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
