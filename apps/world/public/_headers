/assets/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=86400

/screenshots/*
  Cache-Control: public, max-age=86400

/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/protos/*
  Cache-Control: no-cache
  Access-Control-Allow-Origin: *

# Las reglas se heredan: hay que soltar el no-cache de /protos/* para que
# el max-age largo no se concatene. El nombre con hash lo pone el build.
/protos/audio/*.m4a
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/api/*
  Cache-Control: no-store
